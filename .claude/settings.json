{
  "permissions": {
    "allow": [
      "Bash(python .claude/skills/*)",
      "Bash(./mvnw *)",
      "Bash(mvnw.cmd *)",
      "Bash(cd * && ./mvnw *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(**/target/**)",
      "Write(**/target/**)",
      "Edit(**/mvnw*)",
      "Edit(**/.mvn/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/java_guard.py\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/build_gate.py\"", "timeout": 600 }
        ]
      }
    ]
  }
}
